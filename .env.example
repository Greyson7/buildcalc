# --- BuildCalc environment variables -------------------------------------
# Every NEXT_PUBLIC_* value is read at BUILD time and inlined into the bundle.
# Copy to .env.local for local overrides, or pass them in the deploy command.

# Base path. Use "/<repo>" for a GitHub Pages project site; leave EMPTY for a
# custom domain served at the root.
NEXT_PUBLIC_BASE_PATH=/buildcalc

# Canonical site URL — used for the <link rel="canonical"> and Open Graph tags.
# Point this at the custom domain (e.g. https://buildcalc.com) once attached.
NEXT_PUBLIC_SITE_URL=https://greyson7.github.io/buildcalc

# Plausible analytics domain (privacy-first, cookieless — no consent banner
# needed). When set, the deferred analytics script loads. Leave EMPTY to ship
# with no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Feedback link target — a Google Form URL or a "mailto:" link. Leave EMPTY
# to fall back to the built-in mailto.
NEXT_PUBLIC_FEEDBACK_URL=
