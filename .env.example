# --- BuildCalc environment variables -------------------------------------
# Every NEXT_PUBLIC_* value is read at BUILD time and inlined into the bundle.
# The in-code defaults are already the production values shown here, so a
# plain `npm run build` is production-correct. These are optional overrides
# (e.g. for a staging deploy).

# Base path. Empty for the buildprocalc.com domain root. Use "/<repo>" only
# for a GitHub Pages project-path deploy.
NEXT_PUBLIC_BASE_PATH=

# Canonical site URL — used for the <link rel="canonical"> and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://buildprocalc.com

# Plausible analytics domain (privacy-first, cookieless — no consent banner).
# Set empty to ship with no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=buildprocalc.com

# Feedback link target — a Google Form URL or a "mailto:" link.
NEXT_PUBLIC_FEEDBACK_URL=https://docs.google.com/forms/d/e/1FAIpQLScB5YuDw075VGzb7RbP-MIMIKO97c5_oOo2ZvtucJyH_-twFw/viewform

# Amazon Associates tracking tag (appended to every Amazon affiliate link).
NEXT_PUBLIC_AMAZON_TAG=buildcalc02-20

# Google Search Console verification token — only needed for the URL-prefix
# property method. Leave empty if verifying via a DNS TXT record.
NEXT_PUBLIC_GSC_VERIFICATION=
